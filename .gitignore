# ─────────────────────────────────────────
#  MIRA  –  .gitignore
# ─────────────────────────────────────────

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
env/
venv/
.venv/
*.egg-info/
dist/
build/
*.egg
.eggs/

# Virtual environments
.env
.env.local
.env.*.local

# pytest
.pytest_cache/
.coverage
htmlcov/
*.log

# Node / Frontend
node_modules/
frontend/dist/
frontend/.env
frontend/.env.local
*.tsbuildinfo

# IDEs
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Docker
*.override.yml

# Secrets – never commit these
*.pem
*.key
credentials.json
token.json
